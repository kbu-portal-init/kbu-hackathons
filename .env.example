# ==============================================================================
# KBU Hackathon 2026 - Environment Variables Template
# Copy this file to .env
# For production host:
# /opt/hackathon/.env.production (chmod 640, root:docker)
# ==============================================================================

# ── Required (local dev) ─────────────────────────────────────────────────────

# Application
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication 
BETTER_AUTH_SECRET=your-random-32-character-secret-here
BETTER_AUTH_URL=http://localhost:3000

# Database 
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=kbu_hackathon
DATABASE_URL="postgresql://postgres:password@localhost:5432/kbu_hackathon?schema=public"

# ── Optional (feature-specific) ──────────────────────────────────────────────

# SMTP Mail Server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL="KBU Hackathon <noreply@........>"

# Sentry error monitoring 
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Cloudflare Turnstile 
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2 
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=
