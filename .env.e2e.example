# ==============================================================================
# KBU Hackathon 2026 - E2E Test Environment Template
# Copy to .env.e2e and fill in your test database connection string.
#
# Loaded by playwright.config.ts before the webServer spawns (tests/e2e/global-setup.ts
# loads it again for migrations and seeding).
# ==============================================================================

# Application
PORT=3000
NODE_ENV=test
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication
BETTER_AUTH_SECRET=your-random-32-character-secret-here
BETTER_AUTH_URL=http://localhost:3000

# Disables auth rate limiting in the app; the suite performs far more logins than real traffic
E2E_TEST=1

# Database — use a DEDICATED test database (seed is destructive)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# SMTP — dummy values fine; e2e asserts UI toasts, not email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dummy
SMTP_PASSWORD=dummy
SMTP_FROM_EMAIL="E2E Tests <noreply@example.com>"

# R2 — dummy values fine; R2-dependent actions are skipped in e2e
R2_ENDPOINT=https://example.r2.cloudflarest.com
R2_ACCESS_KEY_ID=dummy
R2_SECRET_ACCESS_KEY=dummy
R2_BUCKET_NAME=dummy
NEXT_PUBLIC_R2_PUBLIC_URL=https://example.r2.dev

# Upstash — leave blank; rate limiting is disabled via E2E_TEST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Contact
LINE_CONTACT_URL=https://line.me/
LINE_CONTACT_NAME=LINE
