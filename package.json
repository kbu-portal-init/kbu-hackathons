{
    "name": "kbu-hackathons",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "check-types": "tsc --noEmit",
        "prepare": "husky",
        "postinstall": "prisma generate",
        "prebuild": "prisma generate",
        "db:push": "prisma db push",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:studio": "prisma studio",
        "db:seed": "tsx prisma/seed.ts",
        "db:start": "docker compose -f docker-compose.local.yml up -d postgres",
        "db:watch": "docker compose -f docker-compose.local.yml up postgres",
        "db:stop": "docker compose -f docker-compose.local.yml stop postgres",
        "db:down": "docker compose -f docker-compose.local.yml down postgres",
        "test:env": "tsx tests/env.test.ts",
        "test:unit": "tsx --test tests/unit/**/*.test.ts tests/env.test.ts",
        "test:unit:watch": "tsx --test --watch tests/unit/**/*.test.ts tests/env.test.ts",
        "test:announcements": "tsx --test tests/announcements*.test.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1134.0",
        "@base-ui/react": "^1.0.0",
        "@hookform/resolvers": "^5.9.1",
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "7.10.0",
        "@sentry/nextjs": "^10.74.0",
        "@upstash/ratelimit": "^2.1.0",
        "@upstash/redis": "^1.38.4",
        "better-auth": "^1.7.5",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.3.0",
        "date-fns": "^4.4.0",
        "dotenv": "^17.4.2",
        "lucide-react": "^0.468.0",
        "next": "16.3.5",
        "next-themes": "^0.4.6",
        "nodemailer": "^10.0.10",
        "pg": "^8.23.0",
        "react": "19.2.8",
        "react-day-picker": "^10.0.1",
        "react-dom": "19.2.8",
        "react-hook-form": "^7.88.0",
        "server-only": "^0.0.1",
        "sonner": "^2.0.8",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.13",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/pg": "^8.23.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "husky": "^9.1.7",
        "lint-staged": "^16.1.6",
        "prisma": "7.10.0",
        "tailwindcss": "^4",
        "tsx": "^4.23.13",
        "typescript": "^5"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json,css,md}": "biome check --write --no-errors-on-unmatched"
    },
    "packageManager": "pnpm@10.27.0"
}
